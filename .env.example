# PostgreSQL
# Local: postgresql://pulse:pulse@localhost:5432/pulse
# Docker: postgresql://pulse:pulse@localhost:5432/pulse
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse"

# Random secret used to sign nothing client-side; keep on the server only.
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Optional object storage (unused in local MVP; files go to public/uploads)
# Profile photos are stored as files under public/uploads/avatars/{userId}/{generation}/
# User.avatarUrl keeps only that path (or a Google photo URL), never the image bytes.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Railway
# Create a NEW project (do not reuse the old FastAPI site).
# 1) Add a PostgreSQL service
# 2) On the web service, set:
#      DATABASE_URL = ${{Postgres.DATABASE_URL}}
#      AUTH_SECRET  = (openssl rand -base64 32)
# 3) Generate a public domain in Settings → Networking

# Public site URL used to build OAuth redirect URIs.
# Production: https://web-production-867a3.up.railway.app
APP_URL="http://localhost:3000"

# Google (Gmail) sign-in — Web application OAuth client
# Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple — Services ID + key with “Sign In with Apple”
# Redirect URI: {APP_URL}/api/auth/apple/callback
# APPLE_PRIVATE_KEY can use \n for newlines.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Future Strava connect (Phase 6 — not used in MVP)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
