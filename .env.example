# PostgreSQL
# Local: postgresql://pulse:pulse@localhost:5432/pulse
# Docker: postgresql://pulse:pulse@localhost:5432/pulse
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse"

# Random secret used to sign nothing client-side; keep on the server only.
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Optional object storage (unused in local MVP; files go to public/uploads)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Future Strava connect (Phase 6 — not used in MVP)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
