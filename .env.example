# PostgreSQL (required for local preferred setup and Railway production)
#
# Local example after creating role/db:
#   CREATE USER strava WITH PASSWORD 'strava';
#   CREATE DATABASE strava_analytics OWNER strava;
# Or: docker compose up -d
DATABASE_URL=postgresql+psycopg://strava:strava@localhost:5432/strava_analytics
#
# Railway:
# 1) Create a PostgreSQL service in the same project
# 2) On the web app service Variables, add a Variable Reference:
#      DATABASE_URL = ${{Postgres.DATABASE_URL}}
#    (use the exact Postgres service name shown in Railway)
# 3) Redeploy the web app so "alembic upgrade head" can create tables
# The app normalizes postgres:// and postgresql:// to postgresql+psycopg://

# Strava OAuth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://SEU-DOMINIO.up.railway.app/auth/strava/callback

# OpenAI
OPENAI_API_KEY=
