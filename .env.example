# PostgreSQL (required for local preferred setup and Railway production)
#
# Local example after creating role/db:
#   CREATE USER strava WITH PASSWORD 'strava';
#   CREATE DATABASE strava_analytics OWNER strava;
# Or: docker compose up -d
DATABASE_URL=postgresql+psycopg://strava:strava@localhost:5432/strava_analytics
#
# Railway:
# 1) Create a PostgreSQL service in the same project
# 2) On the web app service Variables, add a Variable Reference:
#      DATABASE_URL = ${{Postgres.DATABASE_URL}}
#    (use the exact Postgres service name shown in Railway)
# 3) Redeploy the web app so "alembic upgrade head" can create tables
# The app normalizes postgres:// and postgresql:// to postgresql+psycopg://

# Strava OAuth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://SEU-DOMINIO.up.railway.app/auth/strava/callback

# Fernet key for Strava tokens at rest (Foundation V2 Phase E/I).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key forces every athlete to re-OAuth. Do not rotate without a re-encrypt job.
#
# If unset, the app derives a stable key from STRAVA_CLIENT_SECRET so login
# still works — but set TOKEN_ENCRYPTION_KEY explicitly in production.
#
# Railway Phase I checklist:
# 1) Postgres service in the same project; DATABASE_URL = ${{Postgres.DATABASE_URL}}
#    (or DATABASE_PRIVATE_URL if private networking works)
# 2) Set TOKEN_ENCRYPTION_KEY, STRAVA_*, OPENAI_API_KEY on the WEB service
# 3) Deploy (start.sh runs: alembic upgrade head && uvicorn)
# 4) Run once: python scripts/encrypt_strava_tokens.py
# 5) Smoke: scripts/phase_i_production_smoke.py + manual Strava login/sync/logout
TOKEN_ENCRYPTION_KEY=

# Optional: force Secure cookies outside Railway detection
# SESSION_COOKIE_SECURE=1


# OpenAI
OPENAI_API_KEY=
